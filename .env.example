# Copy to .env for Docker Compose. Never commit real API keys.
FEED_MODE=demo
# To use Finnhub quotes, set FEED_MODE=finnhub and provide your key.
FINNHUB_API_KEY=
# 12 symbols every 15 seconds is up to 48 quote requests per minute.
# Set this to fit your provider plan; errors keep the last quote.
FEED_INTERVAL_MS=15000
# Fixes the demo feed's random prices so a run can be replayed. Leave blank and the
# app picks a seed and logs it at startup.
FEED_SEED=
# system runs on the wall clock. simulated freezes time at CLOCK_START; it then moves
# only when POST /api/simulation/ticks advances it, one feed interval per tick, so a
# run with the same FEED_SEED and the same orders replays exactly. Needs FEED_MODE
# demo or static.
CLOCK_MODE=system
CLOCK_START=2026-01-05T14:30:00Z
# house: a simulated market maker quotes around the feed and trades whatever users
# leave. book: no house; orders only trade with each other, so trading alone sets the
# price, the feed is just a reference value and positions are valued at the last trade.
# The HOUSE_ settings below only apply in house mode.
MARKET_MODE=house
# The simulated market maker's spread in basis points (10 = 0.10%). Users can
# trade with each other inside it; 0 makes every order trade with the house.
HOUSE_SPREAD_BPS=10
# Price impact. Trading HOUSE_DEPTH_SHARES shares moves the price HOUSE_IMPACT_BPS,
# and larger orders cost more per share (square-root law). Each quote tick fades the
# move by HOUSE_IMPACT_DECAY. The house also leans its quotes up to
# HOUSE_IMBALANCE_BPS towards the side with more resting orders. 0 turns each off.
HOUSE_IMPACT_BPS=10
HOUSE_DEPTH_SHARES=500
HOUSE_IMPACT_DECAY=0.25
HOUSE_IMBALANCE_BPS=4
